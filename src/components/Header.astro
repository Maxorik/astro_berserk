---

<header class="site-header">
  <a href="/" class="logo">
    <img src="./berslogo.png" />
    <!-- <span class="logo-mark">✦На главную</span> -->
  </a>

  <nav class="main-nav">
    <a href="/lore">легенды</a>
    <a href="/collecting">коллекционирование</a>
    <a href="/other">события</a>
  </nav>

</header>
<style>
.site-header {
	max-width: var(--container);
	margin: 0 auto;
	padding: 20px var(--page-padding);
	display: grid;
	grid-template-columns: 1fr auto 1fr;
	align-items: center;
	border-bottom: 1px solid var(--color-line);
  min-height: 100px;

  background-color: #ce9a65;
}

.logo {
	display: flex;
	align-items: center;
	gap: 12px;
	font-size: 13px;
	font-weight: 500;
	letter-spacing: 0.28em;
  width: 200px;
  background-size: contain;
}

.logo-mark {
	font-size: 20px;
}

.main-nav {
	display: flex;
	gap: 36px;
}

.main-nav a,
.header-actions button {
	font-size: 14px;
	font-weight: 600;
	letter-spacing: 0.2em;
	text-transform: uppercase;
  font: bold Tahoma, Arial, sans-serif;
  color: #7e2015;
}

.main-nav a {
  text-decoration: inherit;
	transition: opacity 0.2s ease;
  position: relative;
}

.main-nav a:hover {
	opacity: 0.5;
}


@media (max-width: 800px) {

  .site-header {
    grid-template-columns: 1fr auto;
  }
  .hero {
    min-height: auto;
    padding-top: 20px;
    padding-bottom: 80px;
  }

  .hero-sidebar {
    display: none;
  }

  .hero-image {
    width: 100%;
    height: 480px;

    margin: 0;
    padding: 0;
  }

  .hero-title {
    top: 300px;
    left: 20px;

    font-size: 18vw;
  }

  .hero-description {
    position: static;

    width: auto;
    margin: 30px 20px 0;
  }

  .article-grid {
    grid-template-columns: 1fr;
  }

  .categories {
    grid-template-columns: repeat(2, 1fr);
  }

  .category {
    min-height: 300px;
  }
}
</style>
